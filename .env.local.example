# Variables de entorno para producción
NEXT_PUBLIC_SITE_URL=https://www.sosinggroup.com
NEXT_PUBLIC_COMPANY_NAME=SOSING GROUP
NEXT_PUBLIC_CONTACT_EMAIL=comercial@sosinggroup.com
NEXT_PUBLIC_DOMAIN=www.sosinggroup.com

# ---- Supabase (plataforma de clientes ECOCHECK) ----
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
WOMPI_EVENTS_SECRET=

# ---- Captura de prospectos del diagnóstico ECOCHECK ----
# Pegue aquí la URL del webhook de Zapier (Catch Hook).
# Si se deja vacío, el formulario envía los datos por WhatsApp.
NEXT_PUBLIC_LEADS_WEBHOOK=

# ---- Píxel de Meta (Facebook / Instagram) ----
# ID que entrega el Administrador de Eventos de Meta
NEXT_PUBLIC_META_PIXEL_ID=

# ---- Captura de prospectos ECOCHECK (servidor) ----
# Correo donde llegan los diagnósticos
LEADS_EMAIL=comercial@sosinggroup.com

# Opción 1 — Resend (recomendado). Envía correo al prospecto Y a SOSING.
# Cree una cuenta gratuita en resend.com y verifique el dominio sosinggroup.com
RESEND_API_KEY=

# Opción 2 — Webhook a Zapier / Make / n8n para el CRM
LEADS_WEBHOOK=

# Respaldo automático: si no hay ninguna de las anteriores, el sistema usa
# FormSubmit hacia LEADS_EMAIL. Requiere confirmar el correo una sola vez.
FORMSUBMIT_ID=
